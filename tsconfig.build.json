// `npm run build`: src/ to dist/ (dist/main.js, dist/maintenance/*.cli.js),
// type-checked on the way. The JSON the app imports (src/i18n/en/lang.json)
// is emitted beside the code.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "incremental": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
