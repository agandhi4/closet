{{>navbar}}

<main class="flex flex-col items-center py-16 px-4">
  <div class="max-w-2xl w-full prose">
    <h1 class="text-3xl font-bold mb-8">{{t 'lang.ABOUT_HEADING' (hash appName=appName)}}</h1>

    {{! Triple-stash on purpose: ABOUT_INTRO carries the upstream attribution
    link. Its inputs are the bundled translation file and APP_NAME from config,
    never user input. }}
    <p class="mb-6">{{{t 'lang.ABOUT_INTRO' (hash appName=appName)}}}</p>

    <h2 class="text-xl font-semibold mt-8 mb-3">{{t 'lang.ABOUT_OPEN_SOURCE'}}</h2>
    <p class="mb-6">{{t 'lang.ABOUT_OPEN_SOURCE_DESC' (hash appName=appName)}}</p>

    <h2 class="text-xl font-semibold mt-8 mb-3">{{t 'lang.ABOUT_TECH'}}</h2>
    <p class="mb-6">{{t 'lang.ABOUT_TECH_DESC'}}</p>

    <p class="text-sm text-base-content/60">{{t 'lang.APP_VERSION'}} {{appRelease}}</p>
  </div>
</main>

{{>dock}}
