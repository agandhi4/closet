{{>navbar}}
<main class="flex flex-col justify-center items-center h-full gap-3">
  {{! Not boosted: a refused change answers 400 with this page re-rendered,
  which a native form post shows but htmx would not swap (its default for
  4xx), leaving the user with no error at all. }}
  <form method="post" action="/auth/change-password" hx-boost="false">
    <fieldset
      class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4"
    >
      <legend class="fieldset-legend">{{t 'lang.CHANGE_PASSWORD'}}</legend>

      <label class="label" for="currentPassword">{{t 'lang.CURRENT_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "currentPassword")}}input-error{{/if}}">
        <input
          id="currentPassword"
          name="currentPassword"
          type="password"
          required
          autocomplete="current-password"
          placeholder="{{t 'lang.CURRENT_PASSWORD'}}"
        />
      </label>
      {{#each (filterErrors validationErrors "currentPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <label class="label" for="newPassword">{{t 'lang.NEW_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "newPassword")}}input-error{{/if}}">
        <input
          id="newPassword"
          name="newPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder="{{t 'lang.NEW_PASSWORD'}}"
        />
      </label>
      {{#each (filterErrors validationErrors "newPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <label class="label" for="confirmPassword">{{t 'lang.CONFIRM_PASSWORD'}}</label>
      <label class="input {{#if (filterErrors validationErrors "confirmPassword")}}input-error{{/if}}">
        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          required
          autocomplete="new-password"
          placeholder="{{t 'lang.CONFIRM_PASSWORD'}}"
        />
      </label>
      {{#each (filterErrors validationErrors "confirmPassword")}}
      <p class="text-error">{{this}}</p>
      {{/each}}

      <button type="submit" class="btn btn-neutral mt-4">
        {{t 'lang.CHANGE_PASSWORD'}}
      </button>
    </fieldset>
  </form>
</main>
{{>dock}}
