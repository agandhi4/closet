{{>navbar}}
<main class="flex flex-col justify-center items-center h-full gap-3">
  {{#if passwordChanged}}
  <div role="status" class="alert alert-success">
    <span>{{t 'lang.PASSWORD_CHANGED'}}</span>
  </div>
  {{/if}}
  <h1 class="text-2xl">{{user.email}}</h1>
  <a class="link" href="/auth/update-email">{{t 'lang.UPDATE_EMAIL'}}</a>
  <a class="link" href="/auth/change-password">{{t 'lang.CHANGE_PASSWORD'}}</a>
  <a class="link" href="/wardrobe-share/manage">{{t 'lang.WARDROBE_SHARING'}}</a>
  <a class="link" href="/auth/delete-account">{{t 'lang.DELETE_ACCOUNT'}}</a>
</main>
{{>dock}}
