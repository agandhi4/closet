<!DOCTYPE html>
{{!-- JSX twin: src/web/layout/layout.tsx renders the same shell for ported
pages. Change both until the last Handlebars page is ported. --}}
{{!-- locale value is for internationalization comes from the nest-i18n module
and is provided globally in the ViewContextMiddleware
https://nestjs-i18n.com/quick-start --}}
{{! data-signed-in: pwa.js starts Web Push (push.js) only on signed-in pages;
the session cookie is httpOnly, so scripts cannot tell. }}
<html lang="{{locale}}" {{#if user}}data-signed-in{{/if}}>
  <head>
    <meta charset="UTF-8" />
    {{! No viewport-fit=cover: iOS standalone handles the safe areas itself,
    and cover puts content under the home indicator (frontend-pwa.md). }}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{! https://developer.chrome.com/docs/lighthouse/seo/meta-description }}
    <meta name="description" content="{{ogDescription}}" />
    {{!-- Canonical URL --}}
    <link rel="canonical" href="{{canonicalUrl}}" />
    {{!-- Facebook Open Graph Meta Tags https://ogp.me/ --}}
    <meta property="og:locale" content="{{ogLocale}}" />
    <meta property="og:url" content="{{ogUrl}}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ogTitle}}" />
    <meta property="og:description" content="{{ogDescription}}" />
    <meta property="og:image" content="{{ogImage}}" />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1000" />
    {{!-- Twitter Open Graph Meta Tags https://ogp.me/ --}}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="{{siteUrl}}" />
    <meta property="twitter:url" content="{{ogUrl}}" />
    <meta name="twitter:title" content="{{ogTitle}}" />
    <meta name="twitter:description" content="{{ogDescription}}" />
    <meta name="twitter:image" content="{{ogImage}}" />
    <meta property="og:site_name" content="{{appName}}" />

    {{!-- Every first-party static URL carries ?v=appVersion (src/build-info.ts):
    app.ts serves /modules, /js, /assets and bundle.css immutable for a year,
    so the key is what rolls the cache on deploy. --}}
    <link rel="icon" href="/favicon.ico?v={{appVersion}}" sizes="48x48" />
    {{!--
    https://developer.apple.com/library/archive/documentation/AppleApplications/Reference/SafariWebContent/ConfiguringWebApplications/ConfiguringWebApplications.html
    https://developer.chrome.com/docs/lighthouse/pwa/apple-touch-icon --}}
    <link rel="apple-touch-icon" href="/assets/{{iconName}}?v={{appVersion}}" />

    {{!-- https://htmx.org/reference/#config: view transitions on every swap
    (https://htmx.org/attributes/hx-swap/#modifiers) and no attribute
    inheritance (https://htmx.org/quirks/#attribute-inheritance) --}}
    <meta
      name="htmx-config"
      content='{"globalViewTransitions":true,"disableInheritance":true}'
    />

    <title>{{#if pageTitle}}{{pageTitle}}{{else}}{{appName}}{{/if}}</title>
    {{! Used inconjunction with service worker sw.js to enable PWA (Progressive
    Web App) functionality. Served from config by src/web/shell, not a static file. }}
    <link rel="manifest" href="/manifest.json" />
    {{! Include assets/main.css and build output from TailwindCSS/DaisyUI }}
    <link href="/bundle.css?v={{appVersion}}" rel="stylesheet" />
    {{! Served modules from node_modules, look to app.ts to see how this is
    performed. https://htmx.org/docs/#installing
    https://blog.wesleyac.com/posts/why-not-javascript-cdn }}
    <script defer src="/modules/htmx.min.js?v={{appVersion}}"></script>
    <script defer src="/modules/_hyperscript.min.js?v={{appVersion}}"></script>
    <script defer src="/js/color-multiselect.js?v={{appVersion}}"></script>
    {{! Bare specifiers for every ES module the pages import, so the versioned
    URL lives here once. Page-specific modules (sortablejs, background
    removal) are only fetched by the page that imports them. }}
    <script type="importmap">
      {
        "imports": {
          "onnxruntime-web": "/modules/onnxruntime-web/dist/ort.all.bundle.min.mjs?v={{appVersion}}",
          "onnxruntime-web/webgpu": "/modules/onnxruntime-web/dist/ort.webgpu.bundle.min.mjs?v={{appVersion}}",
          "@imgly/background-removal": "/modules/background-removal/index.mjs?v={{appVersion}}",
          "sortablejs": "/modules/modular/sortable.esm.js?v={{appVersion}}",
          "workbox-window": "/modules/workbox-window.prod.mjs?v={{appVersion}}",
          "pulltorefreshjs": "/modules/pulltorefresh/index.esm.js?v={{appVersion}}",
          "toast": "/js/toast.js?v={{appVersion}}",
          "mask-editor": "/js/mask-editor.js?v={{appVersion}}",
          "push": "/js/push.js?v={{appVersion}}"
        }
      }
    </script>
    {{! Heartbeat-driven online/offline state and the banner in app_status;
    runs everywhere, service worker or not. }}
    <script type="module" src="/js/connectivity.js?v={{appVersion}}"></script>
    {{#if pwaEnabled}}
    <script
      type="module"
      src="/modules/pwa-install.bundle.js?v={{appVersion}}"
    ></script>
    {{! Service worker registration, update toast, Web Push, iOS pull to
    refresh. In the head so hx-boost body swaps never re-run it. }}
    <script type="module" src="/js/pwa.js?v={{appVersion}}"></script>
    {{/if}}
    {{! Resource hint for CDN analytics }}
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
  </head>

  {{! hx-boost 'automagically' replaces all anchor tags with htmx logic that
  swaps out the body of the html with the response. This results in a smoother
  user experience where the body gets swapped out without a full page reload
  similar to a SPA. https://htmx.org/attributes/hx-boost/
  https://htmx.org/quirks/#some-people-don-t-like-hx-boost }}
  {{! hx-inherit: with disableInheritance on, hx-boost has to be handed down
  explicitly or no link is boosted. Nothing else in the views inherits. }}
  <body hx-boost="true" hx-inherit="hx-boost" class="h-screen flex flex-col">
    {{! Caution: Triple brackets in handlebarsjs disables auto-escaping and may
    pose a XSS risk with HTMX. However the exception to this rule is when
    loading hbs rendered content which is pre-santized by the handlebars
    templatinng engine as it get's rendered.
    https://handlebarsjs.com/guide/expressions.html#literal-segments
    https://htmx.org/essays/web-security-basics-with-htmx/ }} {{{body}}}
    {{> app_status}}
    {{#if pwaEnabled}}
    <pwa-install id="pwa-install" manifest-url="/manifest.json"></pwa-install>
    {{/if}}
  </body>
</html>
