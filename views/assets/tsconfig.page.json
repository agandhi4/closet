{
  // Type-checks the page's outbox (outbox.ts) against the DOM lib; bundled by
  // esbuild in `npm run generate:outbox`, this config never emits. The bare
  // names it imports from public/js/ resolve through `paths`, as the pages'
  // importmap resolves them in the browser (esbuild keeps them external).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": [],
    "paths": {
      "toast": ["../../public/js/toast.js"],
      "single-flight": ["../../public/js/single-flight.js"]
    }
  },
  "include": ["outbox.ts"]
}
