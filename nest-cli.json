{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*",
        "watchAssets": true
      }
    ],
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [".js", ".ts", ".tsx"],
        "ignore": ["**/*.spec.ts", "**/*.spec.tsx"]
      }
    }
  }
}