+          AND kcu.column_name = c.column_name);`
             );
             const tableChecks = await db.query(`SELECT 
 						tc.constraint_name,
@@ -75271,8 +75274,13 @@ var pushSchema = async (imports, drizzleInstance, schemaFilters, tablesFilter, e
     getTablesFilterByExtensions({ extensionsFilters, dialect: "postgresql" })
   );
   const db = {
-    query: async (query, params) => {
-      const res = await drizzleInstance.execute(sql.raw(query));
+    query: async (query, params = []) => {
+      // Bind $n placeholders: sql.raw(query) alone dropped the params, and the
+      // composite primary key lookup failed with "there is no parameter $1".
+      const chunks = query.split(/\$(\d+)/);
+      const res = await drizzleInstance.execute(
+        sql.join(chunks.map((chunk, i) => i % 2 === 1 ? sql`${params[Number(chunk) - 1]}` : sql.raw(chunk)))
+      );
       return res.rows;
     }
   };
