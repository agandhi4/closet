{
  "name": "closet",
  "version": "0.5.1",
  "description": "Private household wardrobe organizer: garments, outfits, and a calendar.",
  "author": "Aakash Gandhi",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build && npm run generate",
    "generate": "npm run generate:build-info && npm run generate:tailwind && npm run generate:sw",
    "generate:build-info": "ts-node scripts/write-build-info.ts",
    "generate:sw": "esbuild --outfile=views/assets/src-sw.js --bundle views/assets/src-sw.ts && npx workbox injectManifest",
    "generate:sw:watch": "npx workbox injectManifest --watch",
    "generate:tailwind": "npx @tailwindcss/cli -i ./views/assets/main.css -o ./public/bundle.css --minify",
    "generate:tailwind:watch": "npx @tailwindcss/cli -i ./views/assets/main.css -o ./public/bundle.css --minify --watch",
    "generate:icons": "ts-node scripts/generate-icons.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check --cache \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json --tsBuildInfoFile node_modules/.cache/closet/tsc.tsbuildinfo && tsc -p views/assets/tsconfig.json",
    "start": "npm run generate && nest start",
    "start:dev": "concurrently \"nest start --watch\" \"npm run generate:tailwind:watch\"",
    "start:debug": "concurrently \"nest start --debug --watch\" \"npm run generate:tailwind:watch\"",
    "start:prod": "node dist/main",
    "maintenance:reconcile": "node dist/maintenance/reconcile.cli",
    "lighthouse": "lhci autorun",
    "lint": "eslint \"{src,test,scripts}/**/*.{ts,tsx}\" --fix",
    "test": "vitest run --project 'unit*'",
    "test:watch": "vitest --project 'unit*'",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest run --inspect-brk --no-file-parallelism",
    "test:int": "vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "npm run build && playwright test test/smoke.spec.ts --project=chromium",
    "postinstall": "patch-package",
    "test:load": "ts-node scripts/load-test.ts",
    "test:load:baseline": "ts-node scripts/load-test.ts --baseline",
    "test:load:compare": "ts-node scripts/load-test.ts --compare",
    "precommit": "npm run check",
    "precommit:full": "npm run check && npm run verify:push && npm run test:load && npm run lighthouse",
    "test:all": "vitest run",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/closet/eslint \"{src,test,scripts}/**/*.{ts,tsx}\"",
    "check": "concurrently --group --kill-others-on-fail --names format,lint,types,tests \"npm:format:check\" \"npm:lint:check\" \"npm:typecheck\" \"npm:test:all\"",
    "prepare": "node -e \"require('fs').existsSync('.git') && require('child_process').execSync('git config core.hooksPath .githooks')\"",
    "verify:push": "npm run build && playwright test --project=chromium"
  },
  "dependencies": {
    "@aws-sdk/lib-storage": "^3.1009.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.4",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@fastify/view": "^11.0.0",
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-data": "https://staticimgly.com/@imgly/background-removal-data/1.7.0/package.tgz",
    "@khmyznikov/pwa-install": "^0.5.8",
    "@mikro-orm/core": "^6.5.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.5.8",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.11.3",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.0",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.9",
    "htmx.org": "^2.0.7",
    "hyperscript.org": "^0.9.14",
    "joi": "^18.0.1",
    "lodash": "^4.17.21",
    "nestjs-i18n": "^10.5.1",
    "nestjs-pino": "^4.4.1",
    "nestjs-s3": "^3.0.1",
    "onnxruntime-web": "1.21.0",
    "patch-package": "^8.0.1",
    "pg": "8.20.0",
    "pino-pretty": "^13.1.2",
    "pulltorefreshjs": "^0.1.22",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "sortablejs": "^1.15.7",
    "web-push": "^3.6.7",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@mikro-orm/migrations": "^6.5.8",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@playwright/test": "^1.57.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "@tailwindcss/cli": "^4.1.14",
    "@types/autocannon": "^7.12.0",
    "@types/hbs": "^4.0.5",
    "@types/heic-convert": "^2.1.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "~4.0.18",
    "autocannon": "^8.0.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.1.27",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "npm-check-updates": "^19.1.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tailwindcss": "^4.1.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "~4.0.18",
    "workbox-cli": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-recipes": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  }
}
